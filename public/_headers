# Every page and file: no other site may frame the dashboard (clickjacking), browsers keep each file's declared type,
# and a click from the dashboard to a visitor's page or a referrer sends no Referer, so this deployment's address stays
# private. The inline scripts in index.html rule out a script-src rule here.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/js/script.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# FounderData Pro's recorder, built from pro/js/replay.ts (vite.config.ts proScripts). The tracker loads it only for a
# visit the server picks to record. A day in the cache; the tracker adds ?v= from the server to fetch a new release.
/js/replay.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# FounderData Pro's survey card and click map overlay (round 7), built from pro/js/survey.ts and pro/js/map.ts like the
# recorder. The tracker loads survey.js only when a survey is on, and map.js only on a page opened with #fd-map=.
/js/survey.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/js/map.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/share/*
  X-Robots-Tag: noindex, nofollow

# The page itself: always revalidate, so a deploy shows at once and the hashed files below are the only thing cached.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Vite names every file under /assets by its content hash, so a file never changes under its URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, rarely changed: a day in the cache, and a stale copy may serve for a week while it revalidates.
/logo.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted fonts (public/fonts, added with the design system). A month, then revalidate.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000
